{
    "name": "EXPERIMENT 7E",
    "n_gpu": 1,

    "arch": {
        "type": "ImageNetPretrainedLocalGlobalUNet",
        "args": {
            "num_classes": 1,
            "in_ch": 1,
            "global_ch": 64,
            "bottleneck_dropout": 0.1,
            "ssl_checkpoint": "saved/models/PROCESS 1B/model_best.pth",
            "backbone": "resnet18",
            "backbone_pretrained": true,
            "freeze_local_encoder": true,
            "use_roi": true,
            "roi_ch": 1
        }
    },
    "data_loader": {
        "type": "LocalGlobalDataLoader",
        "args": {
            "data_dir": "data/[collapsed]64_tiles_per_image",
            "batch_size": 40,
            "shuffle": true,
            "validation_split": 0.3,
            "num_workers": 0,
            "hflip": 0.5,
            "vflip": 0.5,
            "rot90": 0.75,
            "visualize": false,
            "fg_ratio": 0.3,
            "fg_min": 0.05,
            "require_roi": true,
            "roi_jitter": 0.0,
            "roi_dropout": 0.0,
            "roi_distort": 0.5,
            "roi_distort_strength": 0.0,
            "roi_distort_end": 0.1,
            "roi_distort_ramp_epochs": 200
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.0001,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "bce_dice",
    "metrics": [
        "iou",
        "accuracy"
    ],
    "lr_scheduler": {
        "type": "CosineAnnealingLR",
        "args": {
            "T_max": 800,
            "eta_min": 1e-5
        }
    },
    "trainer": {
        "epochs": 800,
        "save_dir": "saved/",
        "save_period": 25,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 50,
        "tensorboard": true,
        "aux_loss_weight": 0.0
    }
}
