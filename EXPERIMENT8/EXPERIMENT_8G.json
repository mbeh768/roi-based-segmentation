{
    "name": "EXPERIMENT 8G",
    "n_gpu": 1,

    "arch": {
        "type": "ImageNetPretrainedLocalGlobalUNet",
        "args": {
            "num_classes": 1,
            "in_ch": 1,
            "global_ch": 64,
            "bottleneck_dropout": 0.1,
            "ssl_checkpoint": "saved/models/PROCESS 1B/model_best.pth",
            "backbone": "resnet18",
            "backbone_pretrained": true,
            "freeze_local_encoder": true,
            "use_roi": true,
            "roi_ch": 1
        }
    },
    "data_loader": {
        "type": "LocalGlobalDataLoader",
        "args": {
            "data_dir": "data/[collapsed]ctx512_inner512_64tiles",
            "batch_size": 40,
            "shuffle": true,
            "validation_split": 0.3,
            "num_workers": 0,
            "hflip": 0.5,
            "vflip": 0.5,
            "rot90": 0.75,
            "visualize": false,
            "require_roi": true,
            "roi_jitter": 0.0,
            "roi_exclusion": true,
            "roi_exclusion_radius": 0.05
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.0001,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "bce_dice",
    "metrics": [
        "iou",
        "accuracy"
    ],
    "lr_scheduler": {
        "type": "CosineAnnealingLR",
        "args": {
            "T_max": 800,
            "eta_min": 1e-5
        }
    },
    "preprocess": {
        "raw_image_directory": "/media/max/2TBHDD/Max B_files_from Behfar_Shared folder(formatted)/Segmentation_Project/RGB FULL - dataset",
        "global_downsample": 256,
        "czi_max_px": 5000000000,
        "tiling_size": 2048,
        "tile_size": 512,
        "context_size": 512,
        "stride": 256,
        "standardize": true,
        "imagenet_norm": false,
        "collapse": true
    },
    "trainer": {
        "epochs": 800,
        "save_dir": "saved/",
        "save_period": 25,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 100,
        "tensorboard": true,
        "aux_loss_weight": 0.0
    }
}
