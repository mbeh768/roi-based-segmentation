{
    "name": "local_unet_overfit",
    "n_gpu": 1,

    "arch": {
        "type": "SimpleUNet",
        "args": {"num_classes": 1}
    },
    "data_loader": {
        "type": "LocalVentricleDataLoader",
        "args":{
            "data_dir": "data/64_tiles_per_image",
            "batch_size": 14,
            "shuffle": true,
            "validation_split": 0.0,
            "num_workers": 2
        }
    },
    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 1e-4,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "bce_dice",
    "metrics": [
        "accuracy", "iou"
    ],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 1500,
            "gamma": 1.0
        }
    },
    "trainer": {
        "epochs": 1500,

        "save_dir": "saved/",
        "save_period": 100,
        "verbosity": 2,

        "monitor": "min loss",
        "early_stop": 500,

        "tensorboard": true
    }
}
