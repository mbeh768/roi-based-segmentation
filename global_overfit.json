{
    "name": "global_unet_overfit",
    "n_gpu": 1,

    "arch": {
        "type": "SimpleUNet",
        "args": {"num_classes": 1}
    },
    "data_loader": {
        "type": "GlobalVentricleDataLoader",
        "args":{
            "data_dir": "data/",
            "batch_size": 14,
            "shuffle": true,
            "validation_split": 0.0,
            "num_workers": 2
        }
    },
    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 5e-2,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "bce_dice",
    "metrics": [
        "accuracy", "iou"
    ],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 500,
            "gamma": 1.0
        }
    },
    "preprocess": {
        "raw_image_directory": "/media/max/2TBHDD/Max B_files_from Behfar_Shared folder/Segmentation_Project/RGB FULL - dataset/",
        "downsample": 256,
        "czi_max_px": 5000000000,
        "tiling_size": 2048,
        "tile_size": 256,
        "stride": 256
    },

    "trainer": {
        "epochs": 500,

        "save_dir": "saved/",
        "save_period": 100,
        "verbosity": 2,

        "monitor": "min loss",
        "early_stop": 500,

        "tensorboard": true
    }
}
