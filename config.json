{
    "name": "VentricleSegmentation",
    "n_gpu": 1,

    "arch": {
        "type": "ResNetSegmentation",
        "args": {"num_classes": 1}
    },
    "data_loader": {
        "type": "VentricleDataLoader",
        "args":{
            "data_dir": "data/",
            "batch_size": 4,
            "shuffle": true,
            "validation_split": 0.1,
            "num_workers": 2
        }
    },
    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.0001,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "bce_dice",
    "metrics": [
        "accuracy", "pct_low_accuracy_tiles"
    ],
    "lr_scheduler": {
        "type": "CosineAnnealingLR",
        "args": {
            "T_max": 150,
            "eta_min": 1e-4
        }
    },
    "preprocess": {
        "raw_image_directory": "/media/max/2TBHDD/Max B_files_from Behfar_Shared folder/Segmentation_Project/RGB FULL - dataset/",
        "downsample": 256,
        "czi_max_px": 5000000000
    },

    "trainer": {
        "epochs": 100,

        "save_dir": "saved/",
        "save_period": 1,
        "verbosity": 2,

        "monitor": "min val_loss",
        "early_stop": 10,

        "tensorboard": true
    }
}
