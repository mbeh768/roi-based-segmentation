{
    "name": "[VAL] initial experiment",
    "n_gpu": 1,

    "arch": {
        "type": "LocalGlobalUNet",
        "args": {"num_classes": 1}
    },
    "data_loader": {
        "type": "LocalGlobalDataLoader",
        "args":{
            "data_dir": "data/64_tiles_per_image",
            "batch_size": 20,
            "shuffle": true,
            "validation_split": 0.2,
            "num_workers": 2
        }
    },
    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.0001,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "bce_dice",
    "metrics": [
        "iou", "accuracy"
    ],
    "lr_scheduler": {
        "type": "CosineAnnealingLR",
        "args": {
            "T_max": 500,
            "eta_min": 5e-4
        }
    },
    "preprocess": {
        "raw_image_directory": "/media/max/2TBHDD/Max B_files_from Behfar_Shared folder/Segmentation_Project/RGB FULL - dataset/",
        "global_downsample": 256,
        "czi_max_px": 5000000000,
        "tiling_size": 2048,
        "tile_size": 256,
        "stride": 256
    },

    "trainer": {
        "epochs": 1500,

        "save_dir": "saved/",
        "save_period": 1000,
        "verbosity": 2,

        "monitor": "min val_loss",
        "early_stop": 10,

        "tensorboard": true,
        "aux_loss_weight": 0.4
    }
}
