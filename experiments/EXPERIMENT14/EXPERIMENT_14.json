{
    "name": "EXPERIMENT_14_rebalanced",
    "n_gpu": 1,
    "arch": {
        "type": "RebalancedDecoderUNet",
        "args": {
            "num_classes": 1,
            "in_ch": 1,
            "bottleneck_dropout": 0.1,
            "backbone": "resnet18",
            "backbone_pretrained": true,
            "freeze_local_encoder": true,
            "use_roi": true,
            "roi_ch": 1,
            "decoder_widths": [
                96,
                96,
                128,
                192,
                192
            ]
        }
    },
    "data_loader": {
        "type": "LocalGlobalDataLoader",
        "args": {
            "data_dir": "data/[collapsed]t8192_ctx512_inner512_old",
            "batch_size": 10,
            "shuffle": true,
            "validation_split": 0.3,
            "num_workers": 8,
            "hflip": 0.5,
            "vflip": 0.5,
            "rot90": 0.75,
            "visualize": false,
            "require_roi": true,
            "roi_jitter": 0.0,
            "roi_exclusion": true,
            "roi_exclusion_radius": 0.0,
            "n_val_cases": 3
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.0001,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "bce_dice",
    "metrics": [
        "iou",
        "accuracy"
    ],
    "lr_scheduler": {
        "type": "CosineAnnealingLR",
        "args": {
            "T_max": 800,
            "eta_min": 1e-05
        }
    },
    "preprocess": {
        "raw_image_directory": "/mnt/8TBhdd/datasets/mayo_datasets/Max B_files_from Behfar_Shared folder(formatted)/Segmentation_Project/RGB FULL - dataset",
        "global_downsample": 256,
        "czi_max_px": 5000000000,
        "tiling_size": 8192,
        "tile_size": 512,
        "context_size": 512,
        "stride": 256,
        "standardize": true,
        "imagenet_norm": false,
        "collapse": true
    },
    "trainer": {
        "epochs": 800,
        "save_dir": "saved/",
        "save_period": 9999,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 100,
        "tensorboard": true,
        "aux_loss_weight": 0.0,
        "amp": true,
        "amp_dtype": "bfloat16",
        "channels_last": true,
        "cudnn_benchmark": true,
        "accum_steps": 4
    }
}
